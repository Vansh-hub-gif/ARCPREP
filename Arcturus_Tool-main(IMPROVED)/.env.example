# ---------------------------------------------------------------------------
# Required. The uploaded ZIP shipped without a .env, which means GROQ_API_KEY
# was unset and EVERY feature fell back to rule-based Business Benefits.
# Copy this file to .env and fill in your keys before running.
# ---------------------------------------------------------------------------
AI_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional model overrides
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-70b-versatile
GEMINI_MODEL=gemini-2.5-flash

# Pacing
OQUAT_REQUEST_DELAY_SECONDS=3.0

# Business Benefit pipeline tuning (see CHANGELOG.md)
OQUAT_BENEFIT_MAX_ATTEMPTS=3
OQUAT_BENEFIT_MIN_WORDS=15
OQUAT_BENEFIT_MAX_WORDS=60
OQUAT_BENEFIT_MAX_OVERLAP=0.85
OQUAT_BENEFIT_MARK_FAILURES=1
